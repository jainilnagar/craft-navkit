# Normalize text files
* text=auto eol=lf

# PHP / Craft plugin files
*.php text eol=lf
*.twig text eol=lf
*.json text eol=lf
*.neon text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.svg text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Keep development-only files out of Composer package downloads
/.github export-ignore
/.idea export-ignore
/.vscode export-ignore
/tests export-ignore
/node_modules export-ignore
/vendor export-ignore
/coverage export-ignore
/var export-ignore
/.phpstan.cache export-ignore
/.phpunit.cache export-ignore
/.ecs-cache export-ignore
/.ecs.cache export-ignore

# Ignore local/dev config from Composer package archive
/.env export-ignore
/.env.* export-ignore
/phpstan.neon export-ignore
/phpstan.neon.dist export-ignore
/ecs.php export-ignore
/phpunit.xml export-ignore
/phpunit.xml.dist export-ignore
/rector.php export-ignore

# Ignore package/build artifacts
/dist export-ignore
/build export-ignore
/release export-ignore
/releases export-ignore
/*.zip export-ignore
/*.tar export-ignore
/*.tar.gz export-ignore

# Ignore miscellaneous repo files from Composer package archive
/.gitignore export-ignore
/.gitattributes export-ignore
/.editorconfig export-ignore
